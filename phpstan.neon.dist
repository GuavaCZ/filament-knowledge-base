includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true

    ignoreErrors:
        # This IS a config file, but larastan only recognizes the app's config
        # directory, not a package's — false positive for packages.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/filament-knowledge-base.php
        # Part of the public Concerns namespace for users to opt into; nothing
        # in the package itself uses it, so PHPStan sees it as unused.
        -
            identifier: trait.unused
            path: src/Concerns/HasDocumentable.php
